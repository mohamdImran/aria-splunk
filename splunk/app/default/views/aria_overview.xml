<dashboard>
  <label>ARIA — Operations Overview</label>

  <row>
    <panel>
      <single>
        <title>Active Incidents (24h)</title>
        <search>
          <query>index=main sourcetype=aria_pipeline status!=resolved | dedup incident_id | stats count</query>
          <earliest>-24h</earliest><latest>now</latest>
        </search>
        <option name="colorBy">value</option>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x22c55e","0xf97316","0xef4444"]</option>
        <option name="rangeValues">[1,3]</option>
        <option name="underLabel">Last 24 hours</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Avg Causal Confidence</title>
        <search>
          <query>index=main sourcetype=aria_pipeline event_type=rca_complete | stats avg(confidence_score) as c | eval pct=round(c*100,1) | fields pct</query>
          <earliest>-7d</earliest><latest>now</latest>
        </search>
        <option name="unit">%</option>
        <option name="underLabel">DoWhy causal inference (7d)</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Runbooks Executed (7d)</title>
        <search>
          <query>index=main sourcetype=aria_pipeline event_type=runbook_executed | stats count</query>
          <earliest>-7d</earliest><latest>now</latest>
        </search>
        <option name="underLabel">Auto-remediation actions</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>MCP Tool Calls (24h)</title>
        <search>
          <query>index=main sourcetype=aria_pipeline event_type=mcp_call | stats count</query>
          <earliest>-24h</earliest><latest>now</latest>
        </search>
        <option name="underLabel">Via Splunk MCP Server</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Services Monitored</title>
        <search>
          <query>index=main | stats dc(service) as count</query>
          <earliest>-1h</earliest><latest>now</latest>
        </search>
        <option name="underLabel">Across all indexes</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <chart>
        <title>Service Error Rate — Last 1 Hour</title>
        <search>
          <query>index=main | timechart span=1m avg(error_rate) by service</query>
          <earliest>-1h</earliest><latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">Error Rate (%)</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.seriesColors">["0xef4444","0xf97316","0xeab308","0x22c55e","0x3b82f6"]</option>
      </chart>
    </panel>
    <panel>
      <table>
        <title>Recent Incidents</title>
        <search>
          <query>index=main sourcetype=aria_pipeline event_type=incident_created
| eval age=round((now()-_time)/60,1)
| table _time incident_id severity status root_cause confidence_score age
| rename _time as Time, incident_id as "Incident ID", severity as Sev,
         status as Status, root_cause as "Root Cause",
         confidence_score as Confidence, age as "Age (min)"
| sort -Time | head 10</query>
          <earliest>-24h</earliest><latest>now</latest>
        </search>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <chart>
        <title>Incidents by Severity (30d)</title>
        <search>
          <query>index=main sourcetype=aria_pipeline event_type=incident_created | timechart span=1d count by severity</query>
          <earliest>-30d</earliest><latest>now</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.seriesColors">["0xef4444","0xf97316","0xeab308","0x6b7280"]</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Top Root Causes (30d)</title>
        <search>
          <query>index=main sourcetype=aria_pipeline event_type=rca_complete | stats count by root_cause | sort -count | head 8</query>
          <earliest>-30d</earliest><latest>now</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.seriesColors">["0xef4444","0xf97316","0xeab308","0x3b82f6","0xa855f7","0x22c55e","0x06b6d4","0xec4899"]</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>DB Connection Pool — Last Hour</title>
        <search>
          <query>index=main sourcetype=db_metrics | eval pool_pct=round((connection_pool_used/connection_pool_max)*100,1) | timechart span=1m avg(pool_pct) as "Pool %" avg(query_latency) as "Query Latency (ms)"</query>
          <earliest>-1h</earliest><latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleY.text">%</option>
        <option name="charting.seriesColors">["0xf97316","0xa855f7"]</option>
      </chart>
    </panel>
  </row>
</dashboard>
