# ── Splunk MCP Server connection ─────────────────────────────────────────────
#
# Your local Splunk Enterprise instance.
# Default management port is 8089.
SPLUNK_HOST=localhost
SPLUNK_PORT=8089

# MCP Encrypted Token — generated inside the Splunk MCP Server app:
#   Splunk Web → Apps → Splunk MCP Server → Manage Tokens
#   → Create MCP Encrypted Token → Audience: mcp
SPLUNK_TOKEN=your-mcp-encrypted-token-here

# MCP Server endpoint — installed by Splunk MCP Server app (Splunkbase app 7931).
SPLUNK_MCP_URL=https://localhost:8089/services/mcp

# ── Demo mode ─────────────────────────────────────────────────────────────────
# true  = all Splunk calls use local synthetic data (Splunk not required)
# false = real Splunk MCP calls (requires token + MCP Server app installed)
#
# For local development / testing set to true.
DEMO_MODE=true

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Incident state is held in memory when Redis is unavailable.
# Only needed for multi-instance / production deployments.
REDIS_URL=redis://localhost:6379

# ── LLM fallback (optional) ───────────────────────────────────────────────────
# Used only if Splunk hosted models are insufficient for NLP summaries.
# Leave blank to rely entirely on Splunk hosted models + template fallbacks.
OPENAI_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
